---
import Page from "../layouts/Page.astro";
import PageHero from "../components/ui/PageHero.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import NumberedCards from "../components/ui/NumberedCards.astro";
import Callout from "../components/ui/Callout.astro";
import Illustration from "../components/ui/Illustration.astro";
import TeamGrid from "../components/about/TeamGrid.astro";
import aboutHero from "../assets/illustrations/static/about-hero.svg";
import { team } from "../data/team";
import { routes } from "../data/navigation";

const beliefs = [
  {
    title: "Conditions decide outcomes",
    body: "Teaching matters. Whether teaching converts into learning is decided elsewhere: in homes, in teachers' careers, and in whether a student can stay in the system at all.",
  },
  {
    title: "Evidence has to be continuous",
    body: "Surveys are a snapshot and pilots end. We build things people use every week so the evidence keeps arriving, year after year, about the same families, teachers and students.",
  },
  {
    title: "We publish what we learn",
    body: "Findings go out to ministries, funders and schools whether or not they support what we are building, and including when they are not flattering to us.",
  },
  {
    title: "Independence is not for sale",
    body: "Sponsors, partners and clients do not influence what we publish or what we push for. Where a funder has an interest in a study, we declare it on the output.",
  },
];
---

<Page
  title="Who We Are"
  description="A learning innovation lab working on the conditions that decide learning outcomes in Nigeria."
>
  <PageHero
    title="A learning innovation lab"
    lede="We work on the conditions that decide learning outcomes in Nigeria, and we publish what we find."
  >
    <img slot="art" src={aboutHero.src} width="501" height="324" alt="" class="about-hero-art" />
  </PageHero>

  <section class="why container">
    <SectionTitle title="Why we exist" />
    <div class="why__content">
      <Illustration name="study" class="why__illus" label="A parent helping a child study by lamplight" speed={2.5} />
      <div class="why__copy">
        <p class="why__lead">Learning outcomes in Nigeria are shaped by conditions almost nobody is measuring.</p>
        <div class="why__body">
          <p>
            What happens at home. Whether good teachers stay in the profession. Whether students can remain in the
            system at all.
          </p>
          <p>
            We work on those conditions. We build products that people use every week, because that is how evidence
            keeps arriving after a pilot would have ended, and we publish what those products teach us.
          </p>
          <p>
            We are a small organisation. The reason we can matter is that this evidence does not currently exist here,
            and making it visible changes what everyone else can design against.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--surface">
    <div class="beliefs container">
      <SectionTitle title="What we believe" />
      <NumberedCards items={beliefs} />
    </div>
  </section>

  <section class="choose container">
    <SectionTitle title="How we choose what to work on" rule="grey" />
    <div class="choose__cards">
      <article class="choose__card choose__card--tint">
        <h3 class="choose__title">The problems we take</h3>
        <p>If a problem can be solved inside eighteen months, or is already well served, it is not ours.</p>
        <p>We are looking for the ones that take years, where staying is the hard part.</p>
      </article>
      <article class="choose__card">
        <h3 class="choose__title">Where we are today</h3>
        <p>
          Three lines of work are in build: Bloom on homes that support learning, Pathways on teachers who stay and
          progress, and CampusID on students who can stay in the system.
        </p>
        <p>Our first brief is in progress. When it is ready, it goes out in full.</p>
      </article>
    </div>
  </section>

  {
    team.length > 0 && (
      <section class="team-section container">
        <SectionTitle title="Our Team" rule="grey" />
        <TeamGrid members={team} />
      </section>
    )
  }

  <div class="container account">
    <Callout
      title="How we are held to account"
      body="How our research is governed, how providers are checked, and how we handle data about children and families. A child's data is never a revenue line."
      action={{ label: "Governance and safeguarding", href: routes.governance }}
    />
  </div>
</Page>

<style>
  .about-hero-art {
    width: 501px;
    max-width: 100%;
    height: auto;
  }

  .why {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-top: 96px;
    padding-bottom: 96px;
  }
  .why__content {
    display: flex;
    gap: 56px;
    align-items: flex-start;
    justify-content: center;
  }
  .why :global(.why__illus) {
    width: 298px;
    flex-shrink: 0;
  }
  .why__copy {
    flex: 0 1 690px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .why__lead {
    font-size: 32px;
    font-weight: 400;
    color: var(--ink-strong);
  }
  .why__body {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 20px;
    line-height: 28px;
    color: var(--text-muted);
  }

  .beliefs {
    display: flex;
    flex-direction: column;
    gap: 56px;
    padding-top: 96px;
    padding-bottom: 96px;
  }

  /* "How we choose what to work on" (from the Figma phone design; two cards side by side on wider screens) */
  .choose {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-top: 96px;
    padding-bottom: 96px;
  }
  .choose__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .choose__card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 40px 36px;
    border-radius: var(--radius-md);
    background: var(--surface);
    font-size: 18px;
    line-height: 28px;
    color: var(--text-muted);
  }
  .choose__card--tint {
    background: var(--cobalt-50);
  }
  .choose__title {
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.288px;
    color: var(--ink-strong);
  }

  .team-section {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: 96px;
    padding-bottom: 96px;
  }

  .account {
    padding-top: 96px;
    padding-bottom: 160px;
  }

  @media (max-width: 1023px) {
    .why__content {
      flex-direction: column;
      align-items: center;
    }
    .why :global(.why__illus) {
      width: 298px;
      max-width: 100%;
    }
    /* Stacked: the 690px basis would otherwise become the column's height */
    .why__copy {
      flex: none;
      width: 100%;
      max-width: 690px;
    }
  }
  /* Phones: Figma "Who We Are — Mobile" */
  @media (max-width: 767px) {
    .about-hero-art {
      width: 256px;
    }
    .why,
    .beliefs,
    .choose,
    .team-section {
      gap: 40px;
      padding-top: 32px;
      padding-bottom: 32px;
    }
    .why__content {
      gap: 56px;
    }
    .why :global(.why__illus) {
      width: 275px;
    }
    .why__copy {
      gap: 24px;
    }
    .why__lead {
      font-size: 20px;
      letter-spacing: 0.24px;
    }
    .why__body {
      font-size: 16px;
      line-height: 26px;
      gap: 20px;
    }
    .choose__cards {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .choose__card {
      padding: 32px 28px;
      font-size: 16px;
      line-height: 26px;
    }
    .choose__title {
      font-size: 22px;
    }
    .team-section {
      gap: 32px;
    }
    .account {
      padding-top: 32px;
      padding-bottom: 96px;
    }
  }
</style>
