# Copy to .env to try these locally. Without them, job roles come from the Markdown files in src/content/roles.

# Where job roles are edited: the back office, read once per build (see src/lib/backoffice.ts). The secret is the
# same WEBSITE_CONTENT_SECRET as on the back office. On the host, set both for production and staging; the back
# office's Publish button then starts a new build.
BACKOFFICE_URL=
WEBSITE_CONTENT_SECRET=
