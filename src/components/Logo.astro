---
import learn from "../assets/icons/logo-learn.svg?raw";
import space from "../assets/icons/logo-space.svg?raw";

interface Props {
  size?: number;
}
const { size = 80 } = Astro.props;
---

<span class="logo" style={`--size:${size}px`} role="img" aria-label="Learn Space">
  <span class="logo__learn" set:html={learn} />
  <span class="logo__space" set:html={space} />
</span>

<style>
  .logo {
    position: relative;
    display: block;
    width: var(--size);
    height: var(--size);
    border-radius: var(--radius-sm);
    background: var(--cobalt-600);
    flex-shrink: 0;
  }
  .logo__learn,
  .logo__space { position: absolute; left: 29.12%; right: 29.12%; }
  .logo__learn { top: 36.41%; bottom: 53.26%; }
  .logo__space { top: 53.42%; bottom: 36.25%; }
  .logo :global(svg) { width: 100%; height: 100%; }
</style>
