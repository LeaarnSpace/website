---
// Centred page hero: title, intro line and buttons. An illustration
// can be passed in the "art" slot; buttons go in the "actions" slot.
interface Props {
  title: string;
  lede?: string;
  /** Extra line under the lede, e.g. "Last updated …" */
  meta?: string;
  /** "lg": 72px title with a smaller intro line (The Problem, Work With Us) */
  size?: "md" | "lg";
  class?: string;
}
const { title, lede, meta, size = "md", class: className } = Astro.props;
---

<header class:list={["page-hero container", `page-hero--${size}`, className]}>
  {
    Astro.slots.has("art") && (
      <div class="page-hero__art">
        <slot name="art" />
      </div>
    )
  }
  <h1 class="page-hero__title" data-lines data-lines-immediate>{title}</h1>
  {lede && <p class="page-hero__lede">{lede}</p>}
  {meta && <p class="page-hero__meta">{meta}</p>}
  {
    Astro.slots.has("actions") && (
      <div class="page-hero__actions">
        <slot name="actions" />
      </div>
    )
  }
</header>

<style>
  /* Fills the visible screen below the navigation with its content centred, so the next section
     never floats into the first view (same rule as the homepage hero) */
  .page-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 24px;
    /* Tall enough for the screen with Safari's toolbars hidden (lvh); the extra bottom padding keeps
       the content centred in the screen with them showing (svh) */
    min-height: calc(100vh - var(--sticky-nav));
    min-height: calc(100lvh - var(--sticky-nav));
    padding-top: 96px;
    padding-bottom: 96px;
    padding-bottom: calc(96px + 100lvh - 100svh);
    text-align: center;
  }
  .page-hero__art {
    display: flex;
    justify-content: center;
  }
  .page-hero__title {
    max-width: 940px;
    font-size: 64px;
    line-height: 68px;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .page-hero__lede {
    max-width: 700px;
    font-size: 20px;
    line-height: 28px;
    color: var(--text-muted);
  }
  .page-hero--lg .page-hero__title {
    max-width: 1000px;
    font-size: 72px;
    line-height: 72px;
  }
  .page-hero--lg .page-hero__lede {
    max-width: 480px;
    font-size: 16px;
    line-height: 26px;
  }
  .page-hero__meta {
    margin-top: -12px;
    font-size: 12px;
    line-height: 16px;
    color: var(--text-muted);
  }
  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  /* Short laptop and landscape-tablet screens: less padding so the content sits centred, not
     pressed against the bottom edge */
  @media (min-width: 768px) and (max-height: 820px) {
    .page-hero {
      padding-top: 32px;
      padding-bottom: 32px;
      padding-bottom: calc(32px + 100lvh - 100svh);
    }
  }
  /* Desktop: legal and governance pages (Figma 1440) use a taller header with a 72px title */
  @media (min-width: 1024px) {
    .page-hero--tall .page-hero__title {
      font-size: 72px;
      line-height: 72px;
    }
    .page-hero--tall .page-hero__lede {
      max-width: 580px;
      font-size: 16px;
      line-height: 26px;
    }
  }
  /* Tablets (Figma 768 frames): 40px title in a 564px column, tighter padding */
  @media (min-width: 768px) and (max-width: 1023px) {
    .page-hero {
      gap: 18px;
      padding-top: 48px;
      padding-bottom: 48px;
      padding-bottom: calc(48px + 100lvh - 100svh);
    }
    .page-hero__title,
    .page-hero--lg .page-hero__title {
      max-width: 564px;
      font-size: 40px;
      line-height: var(--lh-normal);
      color: var(--ink);
    }
    .page-hero__lede {
      max-width: 704px;
      font-size: 18px;
      line-height: 24px;
      letter-spacing: 0.9px;
      color: var(--ink);
      opacity: 0.8;
    }
    .page-hero--lg .page-hero__lede {
      max-width: 564px;
      font-size: 16px;
      line-height: 26px;
      letter-spacing: 0;
    }
  }
  @media (max-width: 767px) {
    /* Figma phone frames: 28px title, 16/26 intro, 32px above and below */
    .page-hero {
      gap: 16px;
      padding-top: 32px;
      padding-bottom: 32px;
      padding-bottom: calc(32px + 100lvh - 100svh);
    }
    .page-hero__title,
    .page-hero--lg .page-hero__title {
      font-size: 28px;
      line-height: var(--lh-normal);
      letter-spacing: 0.322px;
    }
    .page-hero__lede,
    .page-hero--lg .page-hero__lede {
      font-size: 14px;
      line-height: 18px;
      color: var(--ink);
    }
    .page-hero__meta {
      margin-top: 0;
    }
  }
</style>
