---
// Line-drawn illustration assembled from the Figma vector layers.
// Each piece carries its own draw-on / fade timing taken from the Figma motion data.
import data from "../data/illustrations.json";

interface Props {
  name: "hero" | "child";
  class?: string;
  label: string;
}
const { name, class: className, label } = Astro.props;
const ill = data[name];

const svgs = import.meta.glob<string>("../assets/illustrations/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const svg = (file: string) =>
  (svgs[`../assets/illustrations/${file}`] ?? "").replace(/\sid="[^"]*"/g, "");

const box = (b: Record<string, string>) =>
  Object.entries(b).map(([k, v]) => `${k}:${v}`).join(";");
const background = "background" in ill ? ill.background : undefined;
---

<div
  class:list={["illus", className]}
  style={`aspect-ratio:${ill.width}/${ill.height};--w:${ill.width}px`}
  role="img"
  aria-label={label}
  data-illustration
>
  {background && <div class="illus__piece" style="inset:0" set:html={svg(background)} />}
  {ill.pieces.map((p) => (
    <div
      class="illus__piece"
      style={box(p.box)}
      data-kind={p.anim.kind}
      data-start={p.anim.start}
      data-end={p.anim.end}
      data-ease={p.anim.ease}
    >
      <div class="illus__pad" style={box(Object.keys(p.pad).length ? p.pad : { inset: "0" })} set:html={svg(p.file)} />
    </div>
  ))}
</div>

<style>
  .illus {
    position: relative;
    width: 100%;
    max-width: var(--w);
    overflow: hidden;
  }
  .illus__piece,
  .illus__pad { position: absolute; }
  .illus :global(svg) { width: 100%; height: 100%; }
</style>
