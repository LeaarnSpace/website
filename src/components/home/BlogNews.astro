---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import arrowLight from "../../assets/icons/arrow-light.svg?raw";
import { routes } from "../../data/navigation";
import { getPosts, getNews } from "../../lib/content";
import NewsCard from "../news/NewsCard.astro";
import PostCard from "../blog/PostCard.astro";
import newsImage from "../../assets/images/news.png";

const posts = await getPosts(3);
const news = await getNews(3);
---

<div class="bn container">
  <!-- Blog -->
  <div class="blog">
    <div class="blog__label">
      <h2 class="bn__heading" data-lines>Blog</h2>
      <span class="blog__rule"></span>
    </div>

    <div class="carousel" data-carousel>
      <ul class="carousel__track" data-track>
        {
          posts.map((p) => (
            <li class="post">
              <PostCard post={p} />
            </li>
          ))
        }
      </ul>

      <div class="carousel__controls">
        <div class="carousel__buttons">
          <button class="round round--nav" data-prev aria-label="Previous posts"><span set:html={arrowLight} /></button>
          <button class="round round--nav" data-next aria-label="Next posts"
            ><span class="flip" set:html={arrowLight} /></button
          >
        </div>
        <div class="progress" aria-hidden="true"><span class="progress__fill" data-progress></span></div>
        <Button href={routes.blog} label="See full list" />
      </div>
    </div>
  </div>

  <!-- Latest news -->
  <div class="section-title news__head">
    <h2 class="bn__heading" data-lines>Latest news</h2>
    <span class="section-title__rule"></span>
  </div>

  <div class="news">
    <div class="news__photo">
      <Image src={newsImage} alt="" widths={[229, 458]} sizes="229px" class="news__img" />
    </div>
    <div class="news__list">
      <ul>
        {
          news.map((n) => (
            <li>
              <NewsCard story={n} />
            </li>
          ))
        }
      </ul>
      <Button href={routes.news} label="See full list" />
    </div>
  </div>
</div>

<style>
  .bn {
    max-width: calc(1336px + var(--gutter) * 2);
    padding-top: 96px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }
  .bn__heading {
    font-size: 32px;
    font-weight: 400;
    color: var(--ink-strong);
    white-space: nowrap;
  }

  /* Blog */
  .blog {
    display: grid;
    grid-template-columns: 230px 1fr;
    gap: 98px;
  }
  .blog__label {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 89px;
  }
  .blog__rule {
    height: 1px;
    background: var(--rule);
  }

  .carousel {
    display: flex;
    flex-direction: column;
    gap: 59px;
    min-width: 0;
    margin-right: calc(var(--gutter) * -1);
  }
  .carousel__track {
    display: flex;
    gap: 40px;
    margin: 0;
    /* 12px on the left (and room top/bottom) so a card can grow on hover without being cut off */
    padding: 20px var(--gutter) 12px 12px;
    scroll-padding-left: 12px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .post {
    flex: 0 0 420px;
    scroll-snap-align: start;
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-right: var(--gutter);
  }
  .carousel__buttons {
    display: flex;
    gap: 8px;
  }
  .progress {
    flex: 1;
    height: 6px;
    border-radius: 3px;
    background: var(--cobalt-50);
    overflow: hidden;
  }
  .progress__fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 3px;
    background: var(--action-primary);
  }

  /* Round arrow buttons */
  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    filter: drop-shadow(0 1px 1px var(--shadow-color-sm));
    flex-shrink: 0;
    transition:
      background-color 0.3s ease,
      transform 0.3s ease;
  }
  .round :global(svg) {
    width: 24px;
    height: 24px;
  }
  .round--card {
    width: 40px;
    height: 40px;
    background: var(--paper);
  }
  .round--nav {
    width: 44px;
    height: 44px;
    background: var(--cobalt-600);
  }
  .round--nav:disabled {
    background: var(--cobalt-200);
    cursor: default;
  }
  .round--nav:not(:disabled):hover {
    transform: scale(1.06);
  }
  .flip {
    transform: rotate(180deg);
    display: inline-flex;
  }

  /* News */
  .news__head {
    margin-top: 0;
  }
  /* Right-justified to the page edge (same as the Blog "See full list"), with the
     Figma spacing kept: a 229px photo sitting 43px to the left of the news cards */
  .news {
    display: grid;
    grid-template-columns: 229px minmax(0, 925px);
    gap: 43px;
    justify-content: end;
  }
  .news__photo {
    padding-top: 226px;
  }
  .news__photo :global(.news__img) {
    width: 229px;
    height: 226px;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
  .news__list {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 37px;
  }
  .news__list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  @media (max-width: 1200px) {
    .blog {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .blog__label {
      padding-top: 0;
      max-width: 230px;
    }
    .news {
      grid-template-columns: 1fr;
    }
    .news__photo {
      display: none;
    }
  }
  /* ---------- Tablets: Figma 768 frame ---------- */
  @media (min-width: 768px) and (max-width: 1023px) {
    .bn {
      padding-top: 48px;
      padding-bottom: 48px;
      gap: 48px;
    }
    .blog {
      gap: 32px;
    }
    /* Heading and rule side by side, like the other section titles */
    .blog__label {
      flex-direction: row;
      align-items: center;
      gap: 32px;
      max-width: none;
    }
    .blog__rule {
      flex: 1;
    }
    .news {
      grid-template-columns: 140px minmax(0, 1fr);
      gap: 40px;
    }
    .news__photo {
      display: block;
      padding-top: 141px;
    }
    .news__photo :global(.news__img) {
      width: 140px;
      height: 137px;
    }
    .news__list {
      gap: 24px;
    }
  }
  /* ---------- Phones: Figma 390 frame — posts stacked, no carousel controls ---------- */
  @media (max-width: 767px) {
    .bn {
      padding-top: 48px;
      padding-bottom: 48px;
      gap: 96px;
    }
    .bn__heading {
      font-size: 20px;
      letter-spacing: 0.24px;
    }
    .blog {
      gap: 32px;
    }
    .blog__label {
      flex-direction: row;
      align-items: center;
      gap: 32px;
      max-width: none;
    }
    .blog__rule {
      flex: 1;
    }
    .carousel {
      gap: 16px;
      margin-right: 0;
    }
    .carousel__track {
      flex-direction: column;
      gap: 40px;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
    .post {
      flex: none;
    }
    .post :global(.post-card__title) {
      font-size: 18px;
      letter-spacing: 0.216px;
      -webkit-line-clamp: 2;
    }
    .carousel__controls {
      margin-right: 0;
    }
    .carousel__buttons,
    .progress {
      display: none;
    }
    .news__head {
      margin-bottom: -72px;
    }
    /* Figma's phone frame lists the news without a "See full list" button */
    .news__list :global(.btn) {
      display: none;
    }
  }
</style>
