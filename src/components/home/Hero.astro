---
import Illustration from "../ui/Illustration.astro";
import Button from "../ui/Button.astro";
---

<div class="hero container">
  <Illustration name="hero" class="hero__illus" label="A teacher writing on a board" />
  <div class="hero__copy">
    <h1 class="hero__title" data-lines data-lines-immediate>Researching and building for better learning outcomes</h1>
    <p class="hero__lede" data-lines data-lines-immediate>
      We strengthen the conditions that shape learning, from homes and classrooms to teaching careers
    </p>
  </div>
  <Button href="#the-problem" label="Learn more" />
</div>

<style>
  /* The hero fills exactly the visible screen below the navigation bar, with its four items centred,
     so "Learn more" is always on screen and the next section never peeks in. svh is the height with
     the browser's toolbars showing (iPad/iPhone Safari), so nothing jumps as they hide; vh is the
     fallback for older browsers. On short screens the illustration and headline shrink to fit. */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 40px;
    min-height: calc(100vh - var(--sticky-nav));
    min-height: calc(100svh - var(--sticky-nav));
    padding-top: 32px;
    padding-bottom: 32px;
    text-align: center;
  }
  .hero :global(.hero__illus) {
    width: 405px;
    margin-bottom: -16px;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .hero__title {
    max-width: 1062px;
    font-size: 72px;
    line-height: 72px;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .hero__lede {
    max-width: 680px;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: 0.9px;
    color: var(--text-muted);
  }
  /* Landscape iPads and small laptops: a smaller headline keeps it on two lines */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .hero__title {
      max-width: 860px;
      font-size: 56px;
      line-height: 60px;
    }
  }
  /* Short screens at laptop/tablet widths (landscape iPads with Safari's toolbars) */
  @media (min-width: 768px) and (max-height: 820px) {
    .hero {
      gap: 28px;
    }
    .hero :global(.hero__illus) {
      width: 300px;
    }
    .hero__title {
      max-width: 860px;
      font-size: 56px;
      line-height: 60px;
    }
  }
  @media (min-width: 768px) and (max-height: 680px) {
    .hero :global(.hero__illus) {
      width: 240px;
    }
    .hero__title {
      font-size: 48px;
      line-height: 52px;
    }
  }
  /* Tablets: Figma 768 frame */
  @media (min-width: 768px) and (max-width: 1023px) {
    .hero :global(.hero__illus) {
      margin-bottom: 0;
    }
    .hero__copy {
      gap: 20px;
    }
    .hero__title {
      max-width: 564px;
      font-size: 40px;
      line-height: var(--lh-normal);
      color: var(--ink);
    }
    .hero__lede {
      color: var(--ink);
      opacity: 0.8;
    }
  }
  /* Phones: Figma 390 frame */
  @media (max-width: 767px) {
    .hero {
      padding-top: 24px;
      padding-bottom: 24px;
      gap: 28px;
    }
    .hero :global(.hero__illus) {
      width: 316px;
      margin-bottom: 0;
    }
    .hero__copy {
      gap: 16px;
    }
    .hero__title {
      font-size: 36px;
      line-height: var(--lh-normal);
      color: var(--ink);
    }
    .hero__lede {
      font-size: 14px;
      line-height: 18px;
      letter-spacing: 0;
      color: var(--ink);
      opacity: 0.8;
    }
  }
  /* Short phones (iPhone SE, or a phone with Safari's toolbars showing) */
  @media (max-width: 767px) and (max-height: 700px) {
    .hero {
      gap: 20px;
    }
    .hero :global(.hero__illus) {
      width: 220px;
    }
    .hero__title {
      font-size: 30px;
    }
  }
</style>
