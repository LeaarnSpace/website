---
import Illustration from "../ui/Illustration.astro";
import Button from "../ui/Button.astro";
---

<div class="hero container">
  <Illustration name="hero" class="hero__illus" label="A teacher writing on a board" />
  <div class="hero__copy">
    <h1 class="hero__title" data-lines data-lines-immediate>Researching and building for better learning outcomes</h1>
    <p class="hero__lede" data-lines data-lines-immediate>
      We strengthen the conditions that shape learning, from homes and classrooms to teaching careers
    </p>
  </div>
  <Button href="#the-problem" label="Learn more" />
</div>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
    padding-top: 48px;
    padding-bottom: 96px;
    text-align: center;
  }
  .hero :global(.hero__illus) {
    width: 405px;
    margin-bottom: -16px;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }
  .hero__title {
    max-width: 1062px;
    font-size: 72px;
    line-height: 72px;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .hero__lede {
    max-width: 680px;
    font-size: 18px;
    line-height: 24px;
    letter-spacing: 0.9px;
    color: var(--text-muted);
  }
  /* Tablets: Figma 768 frame */
  @media (min-width: 768px) and (max-width: 1023px) {
    .hero {
      padding-top: 32px;
      padding-bottom: 64px;
    }
    .hero :global(.hero__illus) {
      margin-bottom: 0;
    }
    .hero__copy {
      gap: 20px;
    }
    .hero__title {
      max-width: 564px;
      font-size: 40px;
      line-height: var(--lh-normal);
      color: var(--ink);
    }
    .hero__lede {
      color: var(--ink);
      opacity: 0.8;
    }
  }
  /* Phones: Figma 390 frame */
  @media (max-width: 767px) {
    .hero {
      padding-top: 24px;
      padding-bottom: 48px;
      gap: 28px;
    }
    .hero :global(.hero__illus) {
      width: 316px;
      margin-bottom: 0;
    }
    .hero__copy {
      gap: 16px;
    }
    .hero__title {
      font-size: 36px;
      line-height: var(--lh-normal);
      color: var(--ink);
    }
    .hero__lede {
      font-size: 14px;
      line-height: 18px;
      letter-spacing: 0;
      color: var(--ink);
      opacity: 0.8;
    }
  }
</style>
