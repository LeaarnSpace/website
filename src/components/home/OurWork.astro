---
const products = [
  { name: "Bloom", font: "mansalva", left: 0, top: 0 },
  { name: "PATHWAYS", font: "mansalva", left: 402.27, top: -43 },
  { name: "CampusID", font: "medula", left: 800.53, top: 20 },
];
---

<div class="work container">
  <div class="section-title">
    <h2 class="work__label" data-lines>Our work</h2>
    <span class="section-title__rule"></span>
  </div>

  <div class="work__fit" data-fit="1303">
    <div class="work__stage">
      <p class="work__logotype" aria-hidden="true">Learn Space</p>
      <ul class="work__cards">
        {
          products.map((p) => (
            <li class="work__card" style={`left:${p.left}px;top:${p.top}px`} data-float>
              <span class={`work__name work__name--${p.font}`}>{p.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="work__copy">
    <h3 class="work__title" data-lines>Three conditions, three lines of work</h3>
    <p class="work__sub">Each product works on one condition and generates evidence about it.</p>
  </div>
</div>

<style>
  .work {
    padding-top: 96px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }
  .work > .section-title {
    width: 100%;
  }
  .work__label {
    font-size: 32px;
    font-weight: 400;
    color: var(--ink-strong);
    white-space: nowrap;
  }

  .work__fit {
    width: 100%;
    max-width: 1303px;
    padding-top: 100px;
    padding-bottom: 40px;
    box-sizing: content-box;
  }
  .work__stage {
    position: relative;
    width: 1303px;
    height: 281px;
    transform-origin: 0 0;
  }
  .work__logotype {
    position: absolute;
    left: 0;
    right: 0;
    top: 12px;
    font-family: var(--font-logotype);
    font-size: 222px;
    line-height: normal;
    color: var(--ink-strong);
    white-space: nowrap;
  }
  .work__cards {
    position: absolute;
    left: 37px;
    top: 0;
    width: 1265.8px;
    height: 263px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .work__card {
    position: absolute;
    width: 435.266px;
    height: 263px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--paper);
    border: 2px solid var(--cobalt-border);
    border-radius: var(--radius-md);
    opacity: 0.98;
    will-change: transform;
  }
  .work__name {
    font-size: 40px;
    line-height: 16px;
    color: var(--black);
    white-space: nowrap;
  }
  .work__name--mansalva {
    font-family: var(--font-mansalva);
  }
  .work__name--medula {
    font-family: var(--font-medula);
  }

  .work__copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }
  .work__title {
    max-width: 800px;
    font-size: 32px;
    font-weight: 400;
    color: var(--ink-strong);
  }
  .work__sub {
    max-width: 700px;
    font-size: 16px;
    line-height: 26px;
    color: var(--text-muted);
  }

  /* ---------- Tablets: Figma 768 frame — a straight row of three cards over a smaller logotype ---------- */
  @media (min-width: 768px) and (max-width: 1023px) {
    .work {
      padding-top: 48px;
      padding-bottom: 96px;
      gap: 40px;
    }
    .work__fit {
      padding: 48px 0 0;
      height: auto !important;
    }
    .work__stage {
      width: 100%;
      height: 205px;
      transform: none !important;
    }
    .work__logotype {
      top: 50%;
      translate: 0 -50%;
      text-align: center;
      font-size: 110px;
    }
    .work__cards {
      position: relative;
      left: auto;
      top: 50%;
      width: 100%;
      height: auto;
      display: flex;
      justify-content: center;
      gap: 39px;
      translate: 0 -50%;
    }
    .work__card {
      position: relative;
      left: auto !important;
      top: auto !important;
      width: 170px;
      height: 150px;
    }
    .work__name {
      font-size: 32px;
    }
    .work__card:nth-child(2) .work__name {
      font-size: 22px;
    }
    .work__copy {
      gap: 18px;
      margin-top: -20px;
    }
  }

  /* ---------- Phones: Figma mobile "Three Conditions" — a centred row of small cards ---------- */
  @media (max-width: 767px) {
    .work {
      gap: 32px;
      padding: 48px 20px;
    }
    .work__label {
      font-size: 20px;
      font-weight: 400;
      letter-spacing: 0.24px;
    }
    .work__fit {
      padding: 0;
      height: auto !important;
    }
    .work__stage {
      width: 100%;
      height: 77px;
      transform: none !important;
    }
    /* Uses the separate "translate" property so it doesn't clash with the fade/scale animation */
    .work__logotype {
      left: 0;
      right: 0;
      top: 50%;
      translate: 0 -50%;
      text-align: center;
      font-size: 60px;
    }
    .work__cards {
      position: relative;
      left: auto;
      top: 50%;
      width: 100%;
      height: auto;
      display: flex;
      justify-content: center;
      gap: 16px;
      translate: 0 -50%;
    }
    .work__card {
      position: relative;
      left: auto !important;
      top: auto !important;
      width: 100px;
      height: 75px;
    }
    .work__name {
      font-size: 14px;
    }
    .work__card:first-child .work__name {
      font-size: 16px;
    }
    .work__copy {
      gap: 18px;
      margin-top: -12px;
    }
    .work__title {
      max-width: 230px;
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 0.24px;
    }
  }
</style>
