---
import { Image } from "astro:assets";
import Button from "./Button.astro";
import arrowDark from "../assets/icons/arrow-dark.svg?raw";
import arrowLight from "../assets/icons/arrow-light.svg?raw";
import blog1 from "../assets/images/blog-1.jpg";
import blog2 from "../assets/images/blog-2.png";
import blog3 from "../assets/images/blog-3.jpg";
import newsImage from "../assets/images/news.png";

const posts = [
  {
    image: blog1,
    title: "Five recommendations for education leaders to close the learning gap in ....",
    excerpt:
      "In the last decade, the number of people displaced due to conflict, violence, climate disasters and public health...",
  },
  {
    image: blog2,
    title: "Five-a-day for pupils with a cluster of adaptive approaches",
    excerpt:
      "For any teacher, planning well involves anticipating the learning experience for pupils. Typically, teachers anticipate which ...",
  },
  {
    image: blog3,
    title: "Structured early language support has the potential to improve educational outcom...",
    excerpt:
      "Language is the gateway to learning, not just in English, but in maths, science and the wider curriculum. It is the primary...",
  },
];

const news = [
  { tag: "Finance", date: "2024.05.24", title: "NELFUND opens student loan portal for learners in public tertiary institutions" },
  { tag: "Digital", date: "2022.03", title: "Nigeria Learning Passport expands curriculum access online and offline" },
  { tag: "Policy", date: "2023.10", title: "National policy sets quality standards for Nigeria’s non-state schools" },
];
---

<div class="bn container">
  <!-- Blog -->
  <div class="blog">
    <div class="blog__label">
      <h2 class="bn__heading" data-lines>Blog</h2>
      <span class="blog__rule"></span>
    </div>

    <div class="carousel" data-carousel>
      <ul class="carousel__track" data-track>
        {posts.map((p) => (
          <li class="post">
            <a href="/insights" class="post__link">
              <div class="post__media">
                <div class="post__frame">
                  <Image src={p.image} alt="" widths={[420, 840]} sizes="420px" class="post__img" />
                </div>
              </div>
              <h3 class="post__title">{p.title}</h3>
              <p class="post__excerpt">{p.excerpt}</p>
              <span class="round round--card" aria-hidden="true"><span class="flip" set:html={arrowDark} /></span>
            </a>
          </li>
        ))}
      </ul>

      <div class="carousel__controls">
        <div class="carousel__buttons">
          <button class="round round--nav" data-prev aria-label="Previous posts"><span set:html={arrowLight} /></button>
          <button class="round round--nav" data-next aria-label="Next posts"><span class="flip" set:html={arrowLight} /></button>
        </div>
        <div class="progress" aria-hidden="true"><span class="progress__fill" data-progress></span></div>
        <Button href="/insights" label="See full list" />
      </div>
    </div>
  </div>

  <!-- Latest news -->
  <div class="section-title news__head">
    <h2 class="bn__heading" data-lines>Latest news</h2>
    <span class="section-title__rule"></span>
  </div>

  <div class="news">
    <div class="news__photo">
      <Image src={newsImage} alt="" widths={[229, 458]} sizes="229px" class="news__img" />
    </div>
    <div class="news__list">
      <ul>
        {news.map((n) => (
          <li>
            <a href="/insights" class="news__item">
              <span class="news__meta">
                <strong>{n.tag}</strong>
                <span class="news__dash" aria-hidden="true"></span>
                <time>{n.date}</time>
              </span>
              <span class="news__title">{n.title}</span>
              <span class="round round--card" aria-hidden="true"><span class="flip" set:html={arrowDark} /></span>
            </a>
          </li>
        ))}
      </ul>
      <Button href="/insights" label="See full list" />
    </div>
  </div>
</div>

<style>
  .bn {
    max-width: calc(1336px + var(--gutter) * 2);
    padding-top: 96px;
    padding-bottom: 176px;
    display: flex;
    flex-direction: column;
    gap: 80px;
  }
  .bn__heading { font-size: 32px; font-weight: 700; color: var(--ink-strong); white-space: nowrap; }

  /* Blog */
  .blog { display: grid; grid-template-columns: 230px 1fr; gap: 98px; }
  .blog__label { display: flex; flex-direction: column; gap: 16px; padding-top: 89px; }
  .blog__rule { height: 1px; background: var(--rule); }

  .carousel { display: flex; flex-direction: column; gap: 59px; min-width: 0; margin-right: calc(var(--gutter) * -1); }
  .carousel__track {
    display: flex;
    gap: 40px;
    margin: 0;
    /* 12px on the left (and room top/bottom) so a card can grow on hover without being cut off */
    padding: 20px var(--gutter) 12px 12px;
    scroll-padding-left: 12px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .carousel__track::-webkit-scrollbar { display: none; }
  .post { flex: 0 0 420px; scroll-snap-align: start; }
  .post__link { display: flex; flex-direction: column; height: 440px; }
  .post__media { height: 244px; display: flex; align-items: center; margin-bottom: 24px; }
  /* The image zooms inside this rounded frame, so its corners stay rounded on hover */
  /* On hover the whole image (rounded corners included) grows slightly */
  .post__frame {
    width: 100%;
    height: 220px;
    overflow: hidden;
    border-radius: var(--radius-md);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .post__link:hover .post__frame { transform: scale(1.04); }
  .post__media :global(.post__img) {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: var(--radius-md);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .post__title {
    font-size: 20px;
    font-weight: 700;
    color: var(--black);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 56px;
    margin-bottom: 8px;
  }
  .post__excerpt {
    font-size: 14px;
    line-height: 18px;
    color: var(--black);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post__link .round { margin: auto 20px 0 auto; }

  .carousel__controls {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    margin-right: var(--gutter);
  }
  .carousel__buttons { display: flex; gap: 8px; }
  .progress { flex: 1; height: 6px; border-radius: 3px; background: var(--cobalt-50); overflow: hidden; }
  .progress__fill { display: block; height: 100%; width: 0; border-radius: 3px; background: var(--action-primary); }

  /* Round arrow buttons */
  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    filter: drop-shadow(0 1px 1px rgba(14, 22, 80, 0.06));
    flex-shrink: 0;
    transition: background-color 0.3s ease, transform 0.3s ease;
  }
  .round :global(svg) { width: 24px; height: 24px; }
  .round--card { width: 40px; height: 40px; background: var(--paper); }
  .round--nav { width: 44px; height: 44px; background: var(--cobalt-600); }
  .round--nav:disabled { background: var(--cobalt-200); cursor: default; }
  .round--nav:not(:disabled):hover { transform: scale(1.06); }
  .flip { transform: rotate(180deg); display: inline-flex; }
  /* Arrow nudges forward on hover and eases back when the pointer leaves */
  .post__link:hover .round--card { transform: translateX(15px); }
  .news__item:hover .round--card { transform: translateX(25px); }
  /* Blog arrows also switch to the Figma hover shade */
  .post__link:hover .round--card { background: var(--action-primary-hover); }

  /* News */
  .news__head { margin-top: 0; }
  /* Right-justified to the page edge (same as the Blog "See full list"), with the
     Figma spacing kept: a 229px photo sitting 43px to the left of the news cards */
  .news { display: grid; grid-template-columns: 229px minmax(0, 925px); gap: 43px; justify-content: end; }
  .news__photo { padding-top: 226px; }
  .news__photo :global(.news__img) { width: 229px; height: 226px; object-fit: cover; border-radius: var(--radius-md); }
  .news__list { display: flex; flex-direction: column; align-items: flex-end; gap: 37px; }
  .news__list ul { list-style: none; margin: 0; padding: 0; width: 100%; display: flex; flex-direction: column; gap: 16px; }
  .news__item {
    display: flex;
    align-items: flex-start;
    gap: 76px;
    min-height: 140px;
    padding: var(--space-6) var(--space-7);
    border-radius: var(--radius-md);
    background: var(--cobalt-50);
    align-items: center;
    transition: background-color 0.3s ease;
  }
  .news__meta { display: flex; align-items: center; gap: 8px; align-self: flex-start; padding-top: 4px; white-space: nowrap; }
  .news__meta strong { font-size: 14px; line-height: 18px; letter-spacing: 0.196px; color: var(--ink-strong); }
  .news__meta time { font-size: 12px; line-height: 16px; color: var(--ink-strong); }
  .news__dash { width: 10px; height: 1px; background: var(--ink-strong); }
  .news__title { flex: 1; max-width: 500px; font-size: 20px; color: var(--ink-strong); }
  .news__item .round { margin-left: auto; margin-right: 30px; }

  @media (max-width: 1200px) {
    .blog { grid-template-columns: 1fr; gap: 24px; }
    .blog__label { padding-top: 0; max-width: 230px; }
    .news { grid-template-columns: 1fr; }
    .news__photo { display: none; }
  }
  /* Phones: Figma mobile text sizes */
  @media (max-width: 767px) {
    .bn__heading { font-size: 20px; letter-spacing: 0.24px; }
    .post__title { font-size: 18px; min-height: 0; }
    .post__excerpt { font-size: 14px; line-height: 18px; }
    .news__meta strong { font-size: 12px; line-height: 16px; }
    .news__meta time { font-size: 11px; line-height: 14px; }
    .news__title { font-size: 14px; line-height: 18px; }
  }
  @media (max-width: 640px) {
    .bn { gap: 56px; padding-bottom: 120px; }
    .post { flex-basis: 300px; }
    .post__link { height: auto; gap: 0; }
    .post__media { height: auto; }
    .post__frame,
    .post__media :global(.post__img) { height: 180px; }
    .post__link .round { margin-top: 16px; }
    .carousel { gap: 32px; }
    .carousel__controls { flex-wrap: wrap; }
    .news__item { flex-wrap: wrap; gap: 12px; padding: 20px; }
    .news__title { flex-basis: 100%; order: 2; }
    .news__item .round { position: absolute; display: none; }
  }
</style>
