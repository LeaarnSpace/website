---
// One numbered section of a legal document ("01  Who we are" + its text).
interface Props {
  id: string;
  number: number;
  title: string;
}
const { id, number, title } = Astro.props;
---

<section class="lsec" id={id}>
  <h3 class="lsec__heading">
    <span class="lsec__num">{String(number).padStart(2, "0")}</span>
    {title}
  </h3>
  <div class="lsec__body"><slot /></div>
</section>

<style>
  .lsec {
    display: flex;
    flex-direction: column;
    gap: 14px;
    scroll-margin-top: 32px;
  }
  .lsec__heading {
    display: flex;
    align-items: baseline;
    gap: 12px;
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    color: var(--ink);
  }
  .lsec__num {
    font-size: 12px;
    font-weight: 700;
    line-height: 20px;
    letter-spacing: 0.168px;
    color: var(--cobalt-600);
  }
  .lsec__body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 16px;
    line-height: 26px;
    color: var(--ink);
  }
  .lsec__body :global(p) {
    margin: 0;
  }
  .lsec__body :global(ul) {
    margin: 0;
    padding-left: 20px;
  }
  .lsec__body :global(a) {
    color: var(--cobalt-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  @media (max-width: 767px) {
    .lsec__heading {
      font-size: 18px;
      line-height: 24px;
    }
    .lsec__body {
      font-size: 14px;
      line-height: 22px;
    }
  }
</style>
