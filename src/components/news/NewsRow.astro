---
// One story in a news list: date, headline, category and source, and a round arrow. Links to the
// original article when there's a source link, otherwise to the story's page on this site.
import type { CollectionEntry } from "astro:content";
import RoundArrow from "../ui/RoundArrow.astro";
import { splitDate } from "../../lib/content";
import { routes } from "../../data/navigation";

interface Props {
  story: CollectionEntry<"news">;
}
const { story } = Astro.props;
const { dayMonth, year } = splitDate(story.data.date);
const external = Boolean(story.data.sourceUrl);
const href = story.data.sourceUrl ?? `${routes.news}/${story.id}`;
---

<a href={href} class="row" {...external && { target: "_blank", rel: "noopener" }}>
  <time class="row__date" datetime={story.data.date}>
    <span class="row__day">{dayMonth}</span>
    <span class="row__year">{year}</span>
  </time>
  <span class="row__summary">
    <span class="row__title">{story.data.title}</span>
    <span class="row__meta">
      <span class="row__cat">{story.data.category}</span>
      {story.data.source && <span class="row__source">{story.data.source}</span>}
    </span>
  </span>
  <RoundArrow direction={external ? "up-right" : "right"} size={44} />
  {external && <span class="visually-hidden">(opens the original article in a new tab)</span>}
</a>

<style>
  .row {
    display: flex;
    align-items: center;
    gap: 24px;
    padding: 24px 28px;
    border-radius: 4px;
    background: var(--cobalt-50);
  }
  .row__date {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    width: 120px;
  }
  .row__day {
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
  }
  .row__year {
    font-size: 12px;
    line-height: 16px;
    color: var(--text-subtle);
  }
  .row__summary {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .row__title {
    font-size: 18px;
    font-weight: 500;
    line-height: 24px;
    letter-spacing: 0.9px;
    color: var(--ink);
  }
  .row__meta {
    display: flex;
    gap: 12px;
    font-size: 11px;
    line-height: 14px;
    letter-spacing: 0.154px;
  }
  .row__cat {
    font-weight: 700;
    color: var(--cobalt-600);
  }
  .row__source {
    font-weight: 600;
    color: var(--ink);
  }
  .row:hover :global(.round-arrow) {
    transform: translateX(10px);
  }
  @media (max-width: 767px) {
    /* Figma News-mobile: compact row with a small round arrow */
    .row {
      gap: 8px;
      padding: 12px;
    }
    .row__date {
      width: auto;
      min-width: 56px;
    }
    .row__day {
      font-size: 18px;
      line-height: 24px;
    }
    .row__title {
      font-size: 14px;
      line-height: 18px;
      letter-spacing: 0.196px;
    }
    .row :global(.round-arrow) {
      width: 28px;
      height: 28px;
      margin-left: 4px;
    }
    .row :global(.round-arrow svg) {
      width: 14px;
      height: 14px;
    }
  }
</style>
