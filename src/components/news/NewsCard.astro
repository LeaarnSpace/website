---
// Compact news card (homepage "Latest news", "More news" on story pages): category — date on the
// left, headline in the middle, round arrow on the right that nudges forward on hover.
import type { CollectionEntry } from "astro:content";
import RoundArrow from "../ui/RoundArrow.astro";
import { formatDotDate } from "../../lib/content";
import { routes } from "../../data/navigation";

interface Props {
  story: CollectionEntry<"news">;
}
const { story } = Astro.props;
---

<a href={`${routes.news}/${story.id}`} class="news-card">
  <span class="news-card__meta">
    <strong>{story.data.category}</strong>
    <span class="news-card__dash" aria-hidden="true"></span>
    <time datetime={story.data.date}>{formatDotDate(story.data.date)}</time>
  </span>
  <span class="news-card__title">{story.data.title}</span>
  <RoundArrow />
</a>

<style>
  .news-card {
    display: flex;
    align-items: center;
    gap: 76px;
    min-height: 140px;
    padding: var(--space-6) var(--space-7);
    border-radius: var(--radius-md);
    background: var(--cobalt-50);
  }
  .news-card__meta {
    display: flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    padding-top: 4px;
    white-space: nowrap;
  }
  .news-card__meta strong {
    font-size: 14px;
    line-height: 18px;
    letter-spacing: 0.196px;
    color: var(--ink-strong);
  }
  .news-card__meta time {
    font-size: 12px;
    line-height: 16px;
    color: var(--ink-strong);
  }
  .news-card__dash {
    width: 10px;
    height: 1px;
    background: var(--ink-strong);
  }
  .news-card__title {
    flex: 1;
    max-width: 500px;
    font-size: 20px;
    color: var(--ink-strong);
  }
  .news-card :global(.round-arrow) {
    margin-left: auto;
    margin-right: 30px;
  }
  .news-card:hover :global(.round-arrow) {
    transform: translateX(25px);
  }
  /* Tablets: Figma "Tab news" card — tighter padding, meta and headline side by side */
  @media (min-width: 768px) and (max-width: 1023px) {
    .news-card {
      gap: 12px;
      min-height: 0;
      padding: 25px 27px 21px 34px;
    }
    .news-card__meta {
      padding-top: 0;
    }
    .news-card :global(.round-arrow) {
      width: 30px;
      height: 30px;
      margin-right: 0;
    }
    .news-card :global(.round-arrow svg) {
      width: 18px;
      height: 18px;
    }
    .news-card:hover :global(.round-arrow) {
      transform: translateX(6px);
    }
  }
  @media (max-width: 1023px) {
    .news-card__meta strong {
      font-size: 12px;
      line-height: 16px;
    }
    .news-card__meta time {
      font-size: 11px;
      line-height: 14px;
    }
    .news-card__title {
      font-size: 14px;
      line-height: 18px;
    }
  }
  /* Phones (Figma homepage and news-story frames): category and date on top, headline below with
     a small round arrow beside it */
  @media (max-width: 640px) {
    .news-card {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 12px 16px;
      min-height: 0;
      padding: 18px;
    }
    .news-card__meta {
      grid-column: 1 / -1;
      padding-top: 0;
    }
    .news-card :global(.round-arrow) {
      width: 30px;
      height: 30px;
    }
    .news-card :global(.round-arrow svg) {
      width: 18px;
      height: 18px;
    }
  }
</style>
