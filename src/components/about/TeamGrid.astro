---
// Team photos with the name and role on a frosted glass label (the Figma "Masked colour rectangle").
import { Image } from "astro:assets";
import type { TeamMember } from "../../data/team";

interface Props {
  members: TeamMember[];
}
const { members } = Astro.props;
---

<ul class="team">
  {
    members.map((m) => (
      <li class="member">
        <Image src={m.photo} alt="" widths={[320, 640]} sizes="(max-width: 1023px) 50vw, 320px" class="member__photo" />
        <div class="member__details">
          <span class="member__band" aria-hidden="true" />
          <p class="member__name">{m.name}</p>
          <p class="member__role">{m.role}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .team {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .member {
    position: relative;
    height: 300px;
    overflow: hidden;
  }
  .member :global(.member__photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .member__details {
    position: absolute;
    left: 21px;
    right: 21px;
    bottom: 21px;
    z-index: 1;
    padding: 13px 13px;
  }
  .member__band {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 4px;
    background: rgba(124, 163, 196, 0.1);
    backdrop-filter: blur(10px);
  }
  .member__name {
    font-size: 20px;
    font-weight: 700;
    color: var(--paper);
  }
  .member__role {
    font-size: 16px;
    line-height: 26px;
    color: var(--paper);
  }
  @media (max-width: 1023px) {
    .team {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 767px) {
    .team {
      gap: 16px;
    }
    .member {
      height: 220px;
    }
    .member__details {
      left: 8px;
      right: 8px;
      bottom: 8px;
      padding: 8px;
    }
    .member__name {
      font-size: 16px;
    }
    .member__role {
      font-size: 12px;
      line-height: 16px;
    }
  }
</style>
