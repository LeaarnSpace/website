---
// A downloadable policy document. Without a file yet it shows as a plain card (no broken link).
import download from "../../assets/icons/download.svg?raw";

interface Props {
  title: string;
  /** e.g. "PDF · 02/10/2026" */
  meta: string;
  href?: string;
}
const { title, meta, href } = Astro.props;
const Tag = href ? "a" : "div";
---

<Tag class:list={["doc", { "doc--pending": !href }]} {...href ? { href, download: "" } : { "aria-disabled": "true" }}>
  <span class="doc__details">
    <span class="doc__title">{title}</span>
    <span class="doc__meta">{meta}{!href && " · coming soon"}</span>
  </span>
  <span class="doc__icon" aria-hidden="true" set:html={download} />
</Tag>

<style>
  .doc {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 328px;
    min-height: 85px;
    padding: 18px;
    border: 1px solid var(--panel-border);
    border-radius: 4px;
    background: var(--paper);
    transition: border-color 0.3s ease;
  }
  a.doc:hover {
    border-color: var(--cobalt-400);
  }
  .doc--pending {
    opacity: 0.7;
  }
  .doc__details {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .doc__title {
    font-size: 14px;
    font-weight: 600;
    line-height: 18px;
    letter-spacing: 0.196px;
    color: var(--ink-strong);
  }
  .doc__meta {
    font-size: 12px;
    line-height: 16px;
    color: var(--ink);
  }
  .doc__icon :global(svg) {
    width: 24px;
    height: 24px;
  }
  @media (max-width: 767px) {
    .doc {
      width: 100%;
    }
  }
</style>
