---
// One role in a list (Figma "position"): title and date, team, place, and a round arrow to the role's page.
// Used by the Open roles list and by "Other open roles" on a role's page.
import type { CollectionEntry } from "astro:content";
import RoundArrow from "../ui/RoundArrow.astro";
import { formatLongDate, rolePath } from "../../lib/content";

interface Props {
  role: CollectionEntry<"roles">;
}
const { role } = Astro.props;
const { data } = role;
---

<a href={rolePath(role)} class="role">
  <span class="role__id">
    <strong class="role__title">{data.title}</strong>
    <span class="role__dash" aria-hidden="true"></span>
    <time class="role__date" datetime={data.posted}>{formatLongDate(data.posted)}</time>
  </span>
  <span class="role__team">{data.team}</span>
  <span class="role__place">
    {data.location}
    <span aria-hidden="true">•</span>
    {data.arrangement}
  </span>
  <RoundArrow />
</a>

<style>
  .role {
    display: grid;
    grid-template-columns: minmax(0, 400px) 150px 200px auto;
    justify-content: space-between;
    align-items: center;
    min-height: 100px;
    padding: 24px;
    border-radius: var(--radius-md);
    background: var(--cobalt-50);
  }
  .role__id {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .role__title {
    font-size: 20px;
    line-height: 28px;
    color: var(--ink-strong);
  }
  .role__dash {
    width: 10px;
    height: 1px;
    background: var(--ink-strong);
  }
  .role__date {
    font-size: 18px;
    line-height: 24px;
    letter-spacing: 0.9px;
    color: var(--ink-strong);
  }
  .role__team,
  .role__place {
    font-size: 16px;
    line-height: 26px;
    color: var(--text-subtle);
  }
  .role :global(.round-arrow) {
    margin-right: 30px;
  }
  .role:hover :global(.round-arrow) {
    transform: translateX(15px);
  }
  @media (max-width: 1023px) {
    .role {
      grid-template-columns: 1fr auto;
      gap: 4px 16px;
    }
    .role__id {
      grid-column: 1;
    }
    .role__team,
    .role__place {
      grid-column: 1;
    }
    .role :global(.round-arrow) {
      grid-column: 2;
      grid-row: 1 / span 3;
      margin-right: 0;
    }
  }
  @media (max-width: 767px) {
    .role {
      padding: 20px;
    }
    .role__id {
      flex-wrap: wrap;
      white-space: normal;
    }
    .role__title {
      font-size: 16px;
      line-height: 22px;
    }
    .role__date {
      font-size: 12px;
      letter-spacing: 0.2px;
    }
    .role__team,
    .role__place {
      font-size: 14px;
      line-height: 20px;
    }
  }
</style>
