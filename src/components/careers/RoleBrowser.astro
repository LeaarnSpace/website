---
// "Open roles": search box, team filters and the list of roles (the roles collection: back office or
// src/content/roles). Each role opens its own page with the job description.
import searchIcon from "../../assets/icons/search.svg?raw";
import FilterChips from "../ui/FilterChips.astro";
import RoleRow from "./RoleRow.astro";
import { getRoles } from "../../lib/content";

const roles = await getRoles();
// Filters for the teams that have open roles, in the order set in the back office
const teams = [...new Map(roles.map((r) => [r.data.team, r.data.teamOrder])).entries()]
  .sort((a, b) => a[1] - b[1] || a[0].localeCompare(b[0]))
  .map(([team]) => team);
---

{roles.length === 0 && <p class="roles__none">There are no open roles right now. Check back soon.</p>}
{
  roles.length > 0 && (
    <div class="roles" data-filter-root>
      <label class="search">
        <span class="search__icon" aria-hidden="true" set:html={searchIcon} />
        <span class="visually-hidden">Search roles</span>
        <input type="search" placeholder="Search" data-filter-search />
      </label>
      <FilterChips options={teams} label="Filter roles by team" />

      <ul class="roles__list">
        {roles.map((r) => (
          <li
            data-filter-item
            data-filter-tag={r.data.team}
            data-filter-text={`${r.data.title} ${r.data.team} ${r.data.location}`}
          >
            <RoleRow role={r} />
          </li>
        ))}
      </ul>
      <p class="roles__empty" data-filter-empty hidden>
        No roles match that search right now.
      </p>
    </div>
  )
}

<style>
  .roles {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 1016px;
    padding: 16px;
    border: 1px solid var(--input-border);
    border-radius: var(--radius-md);
    background: var(--paper);
  }
  .search:focus-within {
    border-color: var(--cobalt-400);
  }
  .search__icon :global(svg) {
    width: 20px;
    height: 20px;
  }
  .search input {
    flex: 1;
    border: 0;
    outline: none;
    background: none;
    font: inherit;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.224px;
    color: var(--ink);
  }
  .search input::placeholder {
    color: var(--placeholder);
  }

  .roles__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    padding: 10px 0 0;
    list-style: none;
  }
  .roles__empty,
  .roles__none {
    font-size: 16px;
    color: var(--text-subtle);
  }
</style>
