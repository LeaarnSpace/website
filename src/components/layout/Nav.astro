---
import Logo from "./Logo.astro";
import menuIcon from "../../assets/icons/menu.svg?raw";

import { mainNav as links, routes } from "../../data/navigation";

const current = Astro.url.pathname.replace(/\/$/, "");
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a href={routes.home} class="nav__logo" aria-label="Learn Space home">
      <Logo size={80} />
    </a>

    <!-- Phones only: collapsed menu button (Figma mobile header) -->
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="main-menu" data-nav-toggle>
      <span class="visually-hidden" data-nav-label>Open menu</span>
      <span class="nav__icon" aria-hidden="true" set:html={menuIcon} />
    </button>

    <nav aria-label="Main" class="nav__menu" id="main-menu">
      <ul class="nav__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="nav__link" aria-current={current === l.href ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Phone menu: toggles the drop-down panel; motion.ts listens for "nav:toggle" to pause smooth scrolling
  document.querySelectorAll<HTMLElement>("[data-nav]").forEach((nav) => {
    const toggle = nav.querySelector<HTMLButtonElement>("[data-nav-toggle]")!;
    const label = nav.querySelector<HTMLElement>("[data-nav-label]")!;
    const setOpen = (open: boolean) => {
      nav.classList.toggle("is-open", open);
      toggle.setAttribute("aria-expanded", String(open));
      label.textContent = open ? "Close menu" : "Open menu";
      document.dispatchEvent(new CustomEvent("nav:toggle", { detail: open }));
    };
    toggle.addEventListener("click", () => setOpen(!nav.classList.contains("is-open")));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.classList.contains("is-open")) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia("(min-width: 768px)").addEventListener("change", (e) => e.matches && setOpen(false));
  });
</script>

<style>
  .nav {
    position: relative;
    z-index: 20;
    height: 128px;
    display: flex;
    align-items: center;
    background: var(--paper);
  }
  .nav__inner {
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav__links {
    display: flex;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Figma "nav item": an underline grows in on hover; the current page keeps it */
  .nav__link {
    position: relative;
    display: block;
    padding: 10px;
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
    transition: color 0.3s ease;
  }
  .nav__link::after {
    content: "";
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 6px;
    height: 2px;
    border-radius: 20px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav__link:hover {
    color: var(--cobalt-700);
  }
  .nav__link:hover::after,
  .nav__link[aria-current="page"]::after {
    transform: scaleX(1);
  }
  .nav__link[aria-current="page"] {
    color: var(--cobalt-600);
  }
  .nav__link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .nav__toggle {
    display: none;
  }

  /* ---------- Phones: logo + menu button; links drop down in a panel ---------- */
  @media (max-width: 767px) {
    .nav {
      height: auto;
    }
    .nav__inner {
      padding: 16px 20px;
    }
    .nav__logo :global(.logo) {
      width: 48px;
      height: 48px;
    }

    .nav__toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-right: -10px;
      border-radius: var(--radius-md);
    }
    .nav__toggle:focus-visible {
      outline: 2px solid var(--focus-ring);
    }
    .nav__icon :global(svg) {
      width: 24px;
      height: 24px;
      overflow: visible;
    }
    .nav__icon :global(path) {
      transform-box: fill-box;
      transform-origin: center;
      transition:
        transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.2s ease;
    }
    /* Menu icon turns into a close (×) icon when open */
    .is-open .nav__icon :global(path:nth-child(1)) {
      transform: translateY(5px) rotate(45deg);
    }
    .is-open .nav__icon :global(path:nth-child(2)) {
      opacity: 0;
    }
    .is-open .nav__icon :global(path:nth-child(3)) {
      transform: translateY(-5px) rotate(-45deg);
    }

    .nav__menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 8px 20px 28px;
      background: var(--paper);
      box-shadow: var(--shadow-menu);
      clip-path: inset(0 0 100% 0);
      visibility: hidden;
      transition:
        clip-path 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s linear 0.5s;
    }
    .is-open .nav__menu {
      clip-path: inset(0 0 -60px 0);
      visibility: visible;
      transition:
        clip-path 0.5s cubic-bezier(0.22, 1, 0.36, 1),
        visibility 0s;
    }
    .nav__links {
      flex-direction: column;
      gap: 4px;
    }
    .nav__link {
      display: inline-block;
      padding: 12px 0;
      font-size: 24px;
    }
    .nav__link::after {
      left: 0;
      right: auto;
      width: 100%;
      bottom: 8px;
    }
    .nav__links li {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 0.3s ease,
        transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .is-open .nav__links li {
      opacity: 1;
      transform: none;
    }
    .is-open .nav__links li:nth-child(2) {
      transition-delay: 0.05s;
    }
    .is-open .nav__links li:nth-child(3) {
      transition-delay: 0.1s;
    }
  }
</style>
