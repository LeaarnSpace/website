---
import Page from "../layouts/Page.astro";
import PageHero from "../components/ui/PageHero.astro";
import Button from "../components/ui/Button.astro";
import SectionTitle from "../components/ui/SectionTitle.astro";
import NumberedCards from "../components/ui/NumberedCards.astro";
import BenefitCards from "../components/careers/BenefitCards.astro";
import RoleBrowser from "../components/careers/RoleBrowser.astro";

// TODO: point at the real application form once it exists (roles without an applyUrl link here)
const applyFallbackHref = "#open-roles";

const benefits = [
  {
    title: "Fair, transparent pay",
    body: "We strengthen the conditions that shape learning, from homes and classrooms to teaching careers.",
  },
  {
    title: "Flexible, remote work",
    body: "Shape your schedule and choose where you work best — no fixed office required.",
  },
  {
    title: "Growth-first culture",
    body: "Dedicated learning budgets and mentorship to keep you advancing every quarter.",
  },
  {
    title: "Real impact, weekly",
    body: "Your work reaches real users every week — no waiting months to see results.",
  },
];

const steps = [
  { title: "Apply", body: "Send your CV and a short note on why this problem." },
  { title: "Conversation", body: "A relaxed call with the person you would work with." },
  { title: "Practical Task", body: "A short, unpaid exercise based on real work." },
  { title: "Decision", body: "We reply within a set time, whatever the outcome." },
];
// Figma "How hiring works" rise timing (2s timeline): delay,duration per card
const stepTiming = "0,1.2;0.43,1.2;0.99,1.01;1.65,0.35";
---

<Page
  title="Work With Us"
  description="A small team working on the conditions that decide learning outcomes in Nigeria. See open roles and how hiring works."
>
  <PageHero
    title="Help us make the unmeasured visible"
    lede="We are a small team working on the conditions that decide learning outcomes in Nigeria. If that is the kind of problem you want to spend years on, read on."
    size="lg"
    class="work-hero"
  >
    <Fragment slot="actions">
      <Button href="#open-roles" label="See open roles" />
    </Fragment>
  </PageHero>

  <section class="band band--sunk">
    <div class="offer container">
      <h2 class="offer__title" data-lines>What we offer</h2>
      <BenefitCards items={benefits} />
    </div>
  </section>

  <section class="open container" id="open-roles">
    <SectionTitle title="Open roles" rule="grey" />
    <RoleBrowser fallbackHref={applyFallbackHref} />
  </section>

  <section class="band band--surface">
    <div class="hiring container">
      <SectionTitle title="How hiring works" rule="grey" class="hiring__title" />
      <NumberedCards items={steps} variant="compact" timing={stepTiming} />
    </div>
  </section>
</Page>

<style>
  .offer {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 96px;
    padding-bottom: 96px;
  }
  .offer__title {
    font-size: 32px;
    font-weight: 400;
    color: var(--ink-strong);
  }
  .open {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-top: 96px;
    padding-bottom: 96px;
  }
  .hiring {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-top: 96px;
    padding-bottom: 106px;
  }
  /* Desktop (Figma 1440): taller hero with airy intro lines; the hiring cards have no heading */
  @media (min-width: 1024px) {
    :global(.work-hero) {
      padding-top: 151px;
      padding-bottom: 151px;
    }
    :global(.work-hero .page-hero__lede) {
      max-width: 500px;
      line-height: 36px;
    }
    .hiring :global(.hiring__title) {
      display: none;
    }
  }
  /* Tablets: Figma 768 frame */
  @media (min-width: 768px) and (max-width: 1023px) {
    .offer {
      gap: 40px;
      padding-top: 64px;
      padding-bottom: 64px;
    }
    .open,
    .hiring {
      padding-top: 48px;
      padding-bottom: 48px;
    }
  }
  @media (max-width: 767px) {
    .offer,
    .open,
    .hiring {
      gap: 32px;
      padding-top: 48px;
      padding-bottom: 48px;
    }
    .offer__title {
      font-size: 20px;
    }
  }
</style>
