---
import Base from "../layouts/Base.astro";
import Nav from "../components/layout/Nav.astro";
import Footer from "../components/layout/Footer.astro";
import plug from "../assets/icons/plug.svg";
import socket from "../assets/icons/socket.svg";
---

<Base title="Page not found — Learn Space">
  <section class="layer layer--flat layer--white nf">
    <Nav />
    <div class="nf__stage">
      <div class="nf__scene">
        <img src={socket.src} alt="" class="nf__socket" width="2033" height="640" />
        <img src={plug.src} alt="" class="nf__plug" width="1600" height="312" />
        <div class="nf__copy">
          <p class="nf__small">Error</p>
          <h1 class="nf__code">404</h1>
          <p class="nf__small nf__row">Page <span class="nf__mark">not found</span></p>
        </div>
      </div>
    </div>
  </section>
  <footer class="layer layer--flat layer--navy">
    <Footer />
  </footer>
</Base>

<style>
  .nf {
    overflow: hidden;
  }
  /* The stage fills the screen below the navigation and centres the plug-and-socket scene in it,
     so the footer starts below the first view */
  .nf__stage {
    display: flex;
    align-items: center;
    /* Tall enough for the screen with Safari's toolbars hidden; the bottom padding keeps the scene
       centred in the screen with them showing */
    min-height: calc(100vh - var(--sticky-nav));
    min-height: calc(100lvh - var(--sticky-nav));
    padding-bottom: calc(100lvh - 100svh);
  }
  .nf__scene {
    position: relative;
    width: 100%;
    height: 447px;
    max-width: 1440px;
    margin-inline: auto;
  }
  .nf__copy {
    position: absolute;
    left: 50%;
    top: 87px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .nf__small {
    font-size: 36px;
    font-weight: 500;
    color: var(--ink);
  }
  .nf__code {
    font-size: 100px;
    line-height: 72px;
    font-weight: 700;
    color: var(--ink-strong);
  }
  .nf__row {
    display: flex;
    align-items: center;
    gap: 26px;
    white-space: nowrap;
  }
  .nf__mark {
    position: relative;
    padding-inline: 10px;
    background: linear-gradient(var(--cobalt-100), var(--cobalt-100)) no-repeat 50% calc(50% + 3px) / 100% 17px;
  }

  /* The plug and socket drift toward each other but never quite connect */
  .nf__socket,
  .nf__plug {
    position: absolute;
    width: 34.7%;
    height: auto;
    max-width: none;
  }
  /* Figma tilts the socket by 7.9°. The artwork is 473 wide with its cable extended 1560 to the
     left, so --w / --x describe the visible socket and the cable end never shows on wide screens */
  .nf__socket {
    --w: 32.84%;
    --x: -1.63%;
    width: calc(var(--w) * 2032.9 / 472.9);
    left: calc(var(--x) - var(--w) * 1560 / 472.9);
    top: 182px;
    rotate: -7.9deg;
    transform-origin: 88.37% 17.86%;
    animation: drift-right 3.2s ease-in-out infinite alternate;
  }
  /* The plug artwork is 499 wide; its cable is extended to 1600 so the end is always off screen */
  .nf__plug {
    width: calc(34.7% * 1600 / 499);
    left: 66.5%;
    top: 30px;
    animation: drift-left 3.2s ease-in-out infinite alternate;
  }
  @keyframes drift-right {
    from {
      translate: -24px 6px;
    }
    to {
      translate: 18px -4px;
    }
  }
  @keyframes drift-left {
    from {
      translate: 24px -6px;
    }
    to {
      translate: -18px 4px;
    }
  }

  @media (max-width: 900px) {
    .nf__scene {
      height: 520px;
    }
    .nf__copy {
      top: 40px;
    }
    .nf__socket {
      --w: 60%;
      --x: -14%;
      top: 300px;
    }
    .nf__plug {
      width: calc(60% * 1600 / 499);
      top: 250px;
      left: 54%;
    }
  }
  @media (max-width: 640px) {
    .nf__small {
      font-size: 26px;
    }
    .nf__code {
      font-size: 72px;
      line-height: 64px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nf__socket,
    .nf__plug {
      animation: none;
    }
  }
</style>
