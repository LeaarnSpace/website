---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import plug from "../assets/icons/plug.svg";
import socket from "../assets/icons/socket.svg";
---

<Base title="Page not found — Learn Space">
  <section class="layer layer--flat layer--white nf">
    <Nav />
    <div class="nf__stage">
      <img src={socket.src} alt="" class="nf__socket" width="503" height="299" />
      <img src={plug.src} alt="" class="nf__plug" width="499" height="312" />
      <div class="nf__copy">
        <p class="nf__small">Error</p>
        <h1 class="nf__code">404</h1>
        <p class="nf__small nf__row">Page <span class="nf__mark">not found</span></p>
      </div>
    </div>
  </section>
  <footer class="layer layer--flat layer--navy">
    <Footer />
  </footer>
</Base>

<style>
  .nf { overflow: hidden; }
  .nf__stage { position: relative; height: 447px; max-width: 1440px; margin-inline: auto; }
  .nf__copy {
    position: absolute;
    left: 50%;
    top: 87px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }
  .nf__small { font-size: 36px; font-weight: 500; color: var(--ink); }
  .nf__code { font-size: 100px; line-height: 72px; font-weight: 700; color: var(--ink-strong); }
  .nf__row { display: flex; align-items: center; gap: 26px; white-space: nowrap; }
  .nf__mark {
    position: relative;
    padding-inline: 10px;
    background: linear-gradient(var(--cobalt-100), var(--cobalt-100)) no-repeat 50% calc(50% + 3px) / 100% 17px;
  }

  /* The plug and socket drift toward each other but never quite connect */
  .nf__socket,
  .nf__plug { position: absolute; width: 34.7%; height: auto; max-width: none; }
  .nf__socket { left: -2.56%; top: 215px; animation: drift-right 3.2s ease-in-out infinite alternate; }
  .nf__plug { left: 66.5%; top: 109px; animation: drift-left 3.2s ease-in-out infinite alternate; }
  @keyframes drift-right { from { translate: -24px 6px; } to { translate: 18px -4px; } }
  @keyframes drift-left { from { translate: 24px -6px; } to { translate: -18px 4px; } }

  @media (max-width: 900px) {
    .nf__stage { height: 520px; }
    .nf__copy { top: 40px; }
    .nf__socket { width: 60%; top: 300px; left: -14%; }
    .nf__plug { width: 60%; top: 250px; left: 54%; }
  }
  @media (max-width: 640px) {
    .nf__small { font-size: 26px; }
    .nf__code { font-size: 72px; line-height: 64px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .nf__socket, .nf__plug { animation: none; }
  }
</style>
