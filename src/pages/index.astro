---
import Base from "../layouts/Base.astro";
import Nav from "../components/layout/Nav.astro";
import Hero from "../components/home/Hero.astro";
import Problem from "../components/home/Problem.astro";
import Approach from "../components/home/Approach.astro";
import OurWork from "../components/home/OurWork.astro";
import BlogNews from "../components/home/BlogNews.astro";
import FooterZone from "../components/layout/FooterZone.astro";
---

<Base title="Learn Space — Researching and building for better learning outcomes">
  <section class="layer layer--flat layer--white">
    <Nav />
    <Hero />
    <Problem />
  </section>
  <!-- Rounded top overlaps the Problem section; zooms from a card up to full width as it comes in -->
  <section class="layer layer--surface" data-zoom-in>
    <Approach />
  </section>
  <!-- Lifts off the footer like a card -->
  <section class="layer layer--flat layer--white layer--lift">
    <OurWork />
    <div class="band band--surface">
      <BlogNews />
    </div>
  </section>
  <FooterZone />
</Base>

<style>
  /* Tablets and phones: Figma shows the blog and news on white */
  @media (max-width: 1023px) {
    .band--surface {
      background: var(--paper);
    }
  }
</style>
