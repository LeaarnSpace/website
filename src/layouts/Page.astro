---
// Standard inner page: header, the page's sections on a panel that lifts off the footer,
// then the shared footer zone.
import Base from "./Base.astro";
import Nav from "../components/layout/Nav.astro";
import FooterZone from "../components/layout/FooterZone.astro";

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<Base title={`${title} — Learn Space`} description={description}>
  <div class="layer layer--flat layer--white layer--lift page-panel">
    <Nav sticky />
    <slot />
  </div>
  <FooterZone />
</Base>

<style>
  /* At least one full screen, so the footer never shows in the first view, however short the page
     (lvh: the screen with Safari's toolbars hidden, its tallest; vh for older browsers) */
  .page-panel {
    min-height: 100vh;
    min-height: 100lvh;
  }
</style>
